<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Pigilan ang EOL warning/error -->
    <CheckEolWorkloads>false</CheckEolWorkloads>

    <!-- Pigilan ang pagbura ng reflection types -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>

    <!-- 64-bit Android lamang (Standard sa .NET 8) -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <ApplicationId>com.gasukinani.prowlmobile</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference sa umiiral na Prowl.Runtime -->
    <ProjectReference Include="..\Prowl.Runtime\Prowl.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tamang Silk.NET Packages na umiiral sa NuGet -->
    <PackageReference Include="Silk.NET.Windowing" Version="2.20.0" />
    <PackageReference Include="Silk.NET.Windowing.Sdl" Version="2.20.0" />
    <PackageReference Include="Silk.NET.OpenGLES" Version="2.20.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.20.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>
</Project>
